# ============================================================
# Environment Configuration Template - Church Portal
# Copy this file to .env and replace placeholder values
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=church_portal_user
DB_PASSWORD="your_secure_db_password"
DB_NAME=church_portal
# Set to true when using cloud databases that require SSL (e.g. Aiven, TiDB)
DB_SSL=false

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=8h

# MFA (Multi-Factor Authentication) Encryption Key
# 32-byte (64 hex characters) cryptographic key for AES-256-GCM encryption of TOTP secrets.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# CORS Configuration (Set to your production domain, e.g. https://portal.cogwmphimus.org)
CORS_ORIGIN=https://yourdomain.com

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# SMS Provider Configuration
# Option A: TextBee (Free Android Gateway - https://textbee.dev)
TEXTBEE_API_KEY=""
TEXTBEE_DEVICE_ID=""

# Option B: Semaphore (Philippine SMS - https://semaphore.co)
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME="COG"

# Option C: Twilio (Optional Fallback / International)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Real-Time Email Delivery via Resend.com (Recommended for Render, Vercel & Cloud Deployments)
# Get a free API key at https://resend.com (3,000 free emails/mo over HTTPS port 443 - zero SMTP port blocks)
RESEND_API_KEY=""
RESEND_FROM="Church of God Imus <onboarding@resend.dev>"

# Secondary / Fallback Email Service Configuration (Gmail SMTP or Custom SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-church-email@gmail.com"
SMTP_PASS="your-google-app-password"
EMAIL_FROM="Church of God World Missions - Imus <noreply@cogwmphimus.org>"
ADMIN_EMAIL="admin@cogwmphimus.org"
CONTACT_RECIPIENT_EMAIL="info@cogwmphimus.org"
PORTAL_URL="https://yourdomain.com"

# Meta / Facebook Graph API Configuration (Optional - for Live Stream View Sync)
# Requires a Page Access Token with pages_read_engagement or read_insights permissions
# Obtain from https://developers.facebook.com/tools/explorer/
FB_PAGE_ACCESS_TOKEN=""
