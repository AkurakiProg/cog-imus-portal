{
  "name": "church-portal",
  "version": "1.0.0",
  "description": "Web-based Church Portal for Church of God World Missions Philippines-Imus",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "lint:check": "node scripts/lint_check.js",
    "db:import": "node scripts/import_schema.js",
    "init-db": "mysql -u root -p < database/schema.sql"
